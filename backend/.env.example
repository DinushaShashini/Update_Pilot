# ==============================================================================
# UpdatePilot Backend Environment Configuration (.env.example)
# Copy to .env for local development. Never commit .env or secrets to git.
# ==============================================================================

# Server HTTP Port
PORT=3000

# Application Environment (development | test | production)
NODE_ENV=development

# Allowed CORS Origin for Web Dashboard Frontend
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection String (via Prisma)
# Matches docker-compose.yml defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/updatepilot?schema=public
